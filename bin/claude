#!/usr/bin/env bash
# Claude Code with 1Password secrets. This directory is ahead of ~/.local/bin
# on PATH, so fish and Neovim (claudecode.nvim) both hit this file. op run
# execs the real binary by absolute path, which keeps the wrapper from looping.
set -euo pipefail

resolve_link() {
  local path="$1" target dir
  while [ -L "$path" ]; do
    target=$(readlink "$path")
    case "$target" in
      /*) path=$target ;;
      *)
        dir=$(dirname "$path")
        path="${dir}/${target}"
        ;;
    esac
  done
  dir=$(cd "$(dirname "$path")" && pwd)
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

self=$(resolve_link "$0")
real=""
IFS=':' read -r -a dirs <<< "${PATH}"
for dir in "${dirs[@]}"; do
  [ -n "$dir" ] || continue
  cand="${dir}/claude"
  if [ -x "$cand" ]; then
    cand_real=$(resolve_link "$cand")
    if [ "$cand_real" != "$self" ]; then
      real=$cand_real
      break
    fi
  fi
done

if [ -z "$real" ]; then
  echo "claude: real binary not found on PATH" >&2
  exit 127
fi

envfile="${HOME}/dotfiles/op/secrets.env"
if command -v op >/dev/null 2>&1 && [ -f "$envfile" ]; then
  exec op run --account my.1password.com --env-file="$envfile" -- "$real" "$@"
fi

exec "$real" "$@"
